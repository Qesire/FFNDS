# Observed 2026-10-20: worker, 2 x NVIDIA A100 80GB PCIe, CC 8.0.
# Source from scripts/worker_exec.sh; do not source archived cluster settings.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
export CUDA_HOME=/usr/local/cuda-12.4
export TORCH_CUDA_ARCH_LIST=8.0
export MAX_JOBS=4
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export TOKENIZERS_PARALLELISM=false
export LIGHTX2V_WAN_ONLY_IMPORT=1
export TORCH_EXTENSIONS_DIR="$FFNDS_ROOT/.runtime/cache/worker/torch_extensions"
export TRITON_CACHE_DIR="$FFNDS_ROOT/.runtime/cache/worker/triton"
export PYTHONIOENCODING=utf-8
export PYTHONUNBUFFERED=1
export PYTHONNOUSERSITE=1
export PATH="$FFNDS_ROOT/.venv/bin:$CUDA_HOME/bin:/usr/bin:/bin:$PATH"
export PYTHONPATH="$FFNDS_ROOT/.runtime/code/LightX2V:$FFNDS_ROOT/.runtime/code/HiF4_Sp:$FFNDS_ROOT/.runtime/code/Wan2.2-I2V-A14B-W4A4"
