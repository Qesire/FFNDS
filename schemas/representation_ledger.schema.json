{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearcher optional representation ledger v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_object",
    "representations",
    "connections",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "research_object": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string"
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "expression_or_reduction",
          "relation_to_source",
          "assumptions",
          "dependencies",
          "freedoms",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expression_or_reduction": {
            "type": "string",
            "minLength": 1
          },
          "relation_to_source": {
            "enum": [
              "EXACT",
              "CONDITIONAL",
              "APPROXIMATE",
              "TASK_REDUCTION",
              "ANALOGY",
              "UNRESOLVED"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "freedoms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PAPER_CLAIM",
                  "SOURCE_VERIFIED",
                  "DERIVED",
                  "CONJECTURE"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          },
          "next_discriminator": {
            "type": "string"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "EXACT_EQUIVALENCE",
              "CONDITIONAL_EQUIVALENCE",
              "APPROXIMATION",
              "TASK_REDUCTION",
              "HEURISTIC_ANALOGY",
              "DESIGN_EXTENSION"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "representation_ids",
          "mechanism",
          "different_prediction",
          "cheap_check",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "representation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "different_prediction": {
            "type": "string",
            "minLength": 1
          },
          "cheap_check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SEED",
              "REGISTERED",
              "OBSERVED"
            ]
          },
          "artifact_locator": {
            "type": "string",
            "minLength": 1
          },
          "nearest_prior_art": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
