    "orthogonal_energy": "D - C*C/E",
    "ideal_corrected_after": "[1-h*(a+gamma)]*delta - h*d_perp",
    "oracle_minimizer": "gamma_star = 1/h - a",
    "minimum_ideal_after_energy": "h*h*(D-C*C/E)",
    "original_ideal_after_energy": "E+h*h*D-2*h*C",
    "original_actual_defect": "eta = actual_delta_after - (delta-h*d)",
    "original_actual_energy": "ideal_after_energy + 2*<ideal_delta_after,eta> + ||eta||^2",
    "recovered_original_ideal_defect_dot": "(actual_after_energy-recorded_ideal_after_energy-recorded_defect_energy)/2"
  },
