  "scientific_object": "One-step ideal real-arithmetic lower bound at each unmodified paired trajectory state",
  "definitions": {
    "delta": "z_student - z_dense after actual step_pre",
    "d": "v_student(z_student) - v_dense(z_dense), actual complete model flows",
    "E": "||delta||^2",
    "D": "||d||^2",
    "C": "<delta,d>",
    "h": "sigma - sigma_next > 0",
    "allowed_control_family": "Replace d by d + gamma*delta for arbitrary real scalar gamma at this fixed state pair",
    "control_information": "Oracle: actual teacher difference delta is not available for free in deployment"
  },
  "derivation": {
    "a": "C/E",
    "parallel": "a*delta",
